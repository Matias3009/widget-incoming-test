<?xml version="1.0" encoding="utf-8"?>
<!-- Static picture shown in the widget picker (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding_h"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/widget_padding_h"
    android:paddingBottom="12dp">

    <TextView
        style="@style/PreviewPill"
        android:layout_width="match_parent"
        android:backgroundTint="#F08A3C"
        android:text="@string/preview_row_1" />

    <TextView
        style="@style/PreviewPill"
        android:layout_width="220dp"
        android:backgroundTint="#C6CF45"
        android:text="@string/preview_row_2" />

    <TextView
        style="@style/PreviewPill"
        android:layout_width="160dp"
        android:backgroundTint="#5DB462"
        android:text="@string/preview_row_3" />
</LinearLayout>
